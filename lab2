class Field {
private:
    map<int, char> textures;
    int width; // ширина поля
    int height; //длинна поля
    Enemy** enemy; // ссылка на массив ссылок на конкретные объекты
    int* wallsAndObjects; //0 - пустота, 1-стена, 2-сундук, 3-цель/сундук, 4-враг для генерации по шаблону?

    void setRandomObject(int numObject, int type) { //расстановка объекта на случайных позициях
        int i = 0;
        int x, y;
        while (i < numObject) {
            x = rand() % width;
            y = rand() % height;
            if ((x != 0 || y != 0) && wallsAndObjects[y * width + x] == 0) { // на позиции 0 0 будет игрок
                wallsAndObjects[y * width + x] = type;
                i++;
            }
        }
    }

    void generate() { // расстановка конкретных объектов (создание объектов и сохранение ссылок на них)
        int num3 = rand() % count(wallsAndObjects, wallsAndObjects + (height * width), 3); //определение номера тройки целевого сундука
        for (int i = 0; i < height * width; i++) { // for(auto start{numbers.begin()}; start !=numbers.end(); start++ )
            if (wallsAndObjects[i] == 4) {
                enemy[i] = new Enemy("гопник");
            }
            else if (wallsAndObjects[i] == 3 && num3 != 0) {
                wallsAndObjects[i] = 2;
                num3--;
            }
            else {
                enemy[i] = nullptr;
            }
        }
    }

    void setTextures() {
        textures[0] = '.';
        textures[1] = '#';
        textures[2] = '$';
        textures[3] = '$';
        textures[4] = '!';
        textures[5] = '@';
    }

public:
    Field(int wid, int heg, int* walls, int rChest, int rEnimies){
        width = wid;
        height = heg;
        wallsAndObjects = walls;
        enemy = (Enemy**) malloc(sizeof(Enemy*) * width * height);
        setRandomObject(rChest, 2);
        setRandomObject(rEnimies, 4);
        generate();
        setTextures();
    }

    ~Field() {
        for (int i = 0; i < height * width; i++) {
            if (enemy[i] != nullptr) {
                delete enemy[i];
            }
        }
        free(enemy);
    }

    void paint(int playerX, int playerY) { //поле рисует себя
        wallsAndObjects[playerY * width + playerX] = 5;
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                cout << textures[wallsAndObjects[y * width + x]];
            }
            cout << "\n";
        }
        wallsAndObjects[playerY * width + playerX] = 0;
    }

    bool canmove(int playerX, int playerY) {
        if (playerX < 0 || playerX >= width || playerY<0 || playerY>=height || wallsAndObjects[playerY*width+playerX] == 1) {
            return false;
        }
        return true;
    }

    int getObjectID(int playerX, int playerY) {
        return wallsAndObjects[playerY * width + playerX];
    }

    void popObject(int playerX, int playerY) {
        wallsAndObjects[playerY * width + playerX] = 0;
    }

    Enemy* getEnemy(int playerX, int playerY) {
        return enemy[playerY * width + playerX];
    }

    void popEnemy(int x, int y) {
        delete enemy[x * width + y];
        enemy[x * width + y] = nullptr;
        wallsAndObjects[x * width + y] = 0;
    }
};

class Player : public Smertniy {
private:
    int x; //координаты
    int y;
    int ox; //старые координаты
    int oy;
    int poitions;
    int poitionsEffect;
    bool win; //обозначает победу

public:
    Player(string nam) {
        name = nam;
        x = 0;
        y = 0;
        ox = 0;
        oy = 0;
        hp = 100;
        attack = 30;
        st = 100;
        attackCost = 30;
        defCost = 20;
        staRegen = 30;
        poitions = 0;
        poitionsEffect = 20;
        state = 0;
        win = false; //ещё не победа
    }
    int getX() {
        return x;
    }

    int getY() {
        return y;
    }

    bool move(char dir, Field* field) {
        if (dir == 'a') {
            x--;
        }
        else if (dir == 'd') {
            x++;
        }
        else if (dir == 'w') {
            y--;
        }
        else if (dir == 's') {
            y++;
        }
        bool moved = (*field).canmove(x, y);
        if (!moved) {
            cout << "туда нельзя \n";
            back();
        }
        else {
            if ((*field).getObjectID(x, y) == 2) {
                addPoitions(rand() % 3 + 1);
                (*field).popObject(x, y);
                go();
            }
            else if ((*field).getObjectID(x, y) == 3) {
                setWin(true);
                (*field).popObject(x, y);
                go();
            }
            else if ((*field).getObjectID(x, y) == 4) {
                return true;
            }
            else {
                go();
            }
        }
        return false;
    }

    void go() {
        ox = x;
        oy = y;
    }

    void back() {
        x = ox;
        y = oy;
    }

    void setWin(bool won) {
        win = won;
    }

    bool getWin() {
        return win;
    }

    void addPoitions(int num) {
        poitions += num;
        if (poitions < 0) { poitions = 0; }
    }

    int getPoitions() {
        return poitions;
    }

    int getPoitionsEffect() {
        return poitionsEffect;
    }

    bool action(char act) {
        if (act == '1' && st>=attackCost) {
            state = 1;
            st -= attackCost;
        }
        else if (act == '2' && st >= defCost) {
            state = 2;
            st -= defCost;
        }
        else if (act == '3') {
            state = 3;
            st += staRegen;
            if (st > 100) {
                st = 100;
            }
        }
        else if (act == '4' && poitions > 0) {
            poitions--;
            hp += poitionsEffect;
            state = 4;
        }
        else if (act == '5') {
            state = 5;
        }
        else {
            cout << "что-то пошло не так попробуйте снова\n";
            return false;
        }
        return true;
    }
};

class Fight {
private:
    Player* player;
    Enemy* enemy;
    map<int, string> slovar;
public:
    Fight(Player* pla, Enemy* ene) {
        player = pla;
        enemy = ene;
        slovar[1] = "атакует";
        slovar[2] = "защищается";
        slovar[3] = "переводит дух";
    }
    bool action() {
        (*enemy).zeroState();
        (*player).zeroState();
        while ((*player).getHP() > 0 && (*enemy).getHP() > 0) {
            cout << (*enemy).getName() << " JP:" << (*enemy).getHP() << "\n";
            cout << "враг " << slovar[(*enemy).chooseAction()] << "\n";
            cout << (*player).getName() << " JP:" << (*player).getHP() << " ST:" << (*player).getST() << " Зелий лечения:" << (*player).getPoitions() << "\n";
            cout << "действия:\n1-атака(" << (*player).getAttackCost() <<
                "ST) 2-Защита(" << (*player).getDefCost() << "ST) 3-перевести дух(+" << (*player).getStaRegen() <<
                "ST) 4-использовать зелье(+" << (*player).getPoitionsEffect() << "HP) 5-убежать\n";
            char act;
            cin >> act;
            while (!(*player).action(act)) {
                cin >> act;
            }
            cout << "\n";
            if ((*player).getState() == 1) {
                (*enemy).Hurt((*player).getAttack());
            }
            if ((*enemy).getState() == 1) {
                (*player).Hurt((*enemy).getAttack());
            }
            if ((*player).getState() == 5) {
                cout << player->getName() << " смылся\n";
                return false;
            }
        }
        if ((*player).getHP() <= 0) {
            return false;
        }
        else{
            cout << enemy->getName() << " повержен\n";
            return true;
            
        }
    }
};

