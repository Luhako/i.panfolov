                     0, 1, 2, 1, 0,
                     0, 4, 0, 1, 3 };
    Field field(width, height, objects, rC, rE);
    Player player("Игрок");
    char delta = 0;
    while (true){
        field.paint(player.getX(), player.getY());
        cout << "w-вверх, d-вправо, s-вниз, a-влево \n";
        cin >> delta;
        cout << "\n";
        bool fightStarted = player.move(delta, &field);
        if (fightStarted) {
            Fight fight(&player, field.getEnemy(player.getX(), player.getY()));
            bool forward = fight.action();
            if (!forward) {
                player.back();
            }
            else {
                player.go();
            }
            if (player.getHP()<=0){
                cout << "поражение";
                break;
            }
        }
        if (player.getWin()) {
            cout << "победа!!!";
            break;
        }
    }
