class Smertniy {
protected:
    string name;
    int hp;
    int attack;
    int st;
    int attackCost;
    int defCost;
    int staRegen;
    int state;

public:
    virtual string getName() {
        return name;
    }

    virtual int getHP() {
        return hp;
    }

    virtual int getAttack() {
        return attack;
    }

    virtual int getST() {
        return st;
    }

    virtual int getAttackCost() {
        return attackCost;
    }

    virtual int getDefCost() {
        return defCost;
    }

    virtual int getStaRegen() {
        return staRegen;
    }

    virtual int getState() {
        return state;
    }
    virtual void zeroState() {
        state = 0;
    }

    virtual void Hurt(int damage) {
        if (state != 2){
            hp -= damage;
            if (hp < 0) {
                hp = 0;
            }
        }
    }
};

class Enemy : public Smertniy {
public:
    Enemy(string nam) {
        name = nam;
        hp = 50;
        attack = 15;
        st = 100;
        attackCost = 30;
        defCost = 20;
        staRegen = 30;
        state = 0;
    }
    int chooseAction() {
        state = (rand() % 2 + 1);
        if ((state == 1 && attackCost > st) || (state == 2 && defCost > st)) {
            state = 3;
            st += staRegen;
        }
        if (state == 1) {
            st -= attackCost;
        }
        else if (state == 2) {
            st -= defCost;
        }
        return state;
    }
};

