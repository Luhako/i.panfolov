#include <iostream>
#include <list>
#include <map>

class ICache { //интерфейс для наследования кэшей, чтобы их использовали
public:
    virtual int get(int key) = 0 {

    }

    virtual void put(int key, int znachenie) = 0 {

    }
};

class LRU : public ICache {
private:
    std::list<int> keys;

    std::map<int, int> znach;

    int lenght;

public:
    LRU(int leng) {
        lenght = leng;
    }

    int operator[](int i) {
        return get(i); // ладно пусть будет пока так на всякий случай
    }
    int get(int key) override {
        if (!znach.count(key)) {
            return NULL;
        }
        keys.push_back(key);
        for (auto iter = keys.begin(); iter != keys.end(); iter++) { // сперва была попытка последний вызванный ставить в начало списка и идти сзади но итераторы не так работают похоже...
            if (*iter == key) {
                keys.erase(iter);
                break;
            }
        }
        return znach[key];
    }

    void put(int key, int znachenie) override {
        if (keys.size() == lenght) {
            znach.erase(*(keys.begin()));
            keys.pop_front();
        }
        znach[key] = znachenie;
        keys.push_back(key);
    }
};


class LFU : public ICache {
private:
    std::map<int, int> zaprosy;

    std::map<int, int> znach;

    int lenght;

public:
    LFU(int leng) {
        lenght = leng;
    }
    int operator[](int i) {
        return get(i); // ладно пусть будет пока так на всякий случай
    }

    int get(int key) override {
        if (!znach.count(key)) {
            return NULL;
        }
        zaprosy[key] += 1;
        return znach[key];
    };

    void put(int key, int znachenie) override {
        if (znach.size() == lenght) {
            std::pair<int, int> minobr = { 0, 0 };
            for (std::pair<int, int> i : zaprosy) {
                if (i.second < minobr.second || minobr.second == 0) {
                    minobr = i;
                }
            }
            znach.erase(minobr.first);
            zaprosy.erase(minobr.first);
        }
        zaprosy[key] = 1;
        znach[key] = znachenie;
    };
};

class Fib {
    ICache* cash;
public:
    Fib(ICache& cache) { // нельзя просто ICache вылезает ошибка нельзя создать экземпляр, а это кземпляр? ну да копия получается... так что ссылка
        cash = &cache;
    }
    int solve(int n) {
        if (n == 0 || n == 1) {
            return n;
        }
        int fromCash = (*cash).get(n);
        if (fromCash != NULL) {
            return fromCash;
        }
        int toCash = (solve(n - 1) + solve(n - 2));
        (*cash).put(n, toCash);
        return toCash;
    }
};


int main()
{
    int n;
    std::cout << "Mode 0 = LRU, others = LFU\n";
    std::cin >> n;
    std::cout << "negative number to exit\n";
    if (n == 0) {
        LRU lru(10);
        Fib fibonachi(lru);
        std::cin >> n;
        while (n >= 0) {
            std::cout << fibonachi.solve(n) << "\n";
            std::cin >> n;
        }
    }
    else {
        LFU lfu(10);
        Fib fibonachi(lfu);
        std::cin >> n;
        while (n >= 0) {
            std::cout << fibonachi.solve(n) << "\n";
            std::cin >> n;
        }
    }
    
    
}

